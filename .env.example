# Локальный Ollama API. Для обычного локального сервера API-ключ не нужен.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Модель должна быть предварительно загружена в Ollama.
OLLAMA_MODEL=qwen3.5:9b

# Локальная генерация может занимать больше времени при частичной выгрузке модели в RAM.
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2200
OLLAMA_KEEP_ALIVE=5m

APP_HOST=127.0.0.1
APP_PORT=8000
